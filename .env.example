# API keys are normally added in the app: open Settings in the top right corner.
# This file is the alternative, and how a hosted copy gets its keys.
# Copy it to .env.local, fill it in, and restart `npm run dev`.
# A key saved in Settings is used in preference to one set here.

# Required. Detection runs on TypeSafe's Jev model.
TYPESAFE_API_KEY=

# Optional. One of these lets an AI model turn each condition into a sharper yes/no question.
# Without one, conditions are checked as written. Choose which to use in Settings.
# The OpenAI key is also what picks words out of sound.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional. Calls: an ElevenLabs voice agent, calling from a Twilio number imported into ElevenLabs.
ELEVENLABS_API_KEY=
# The id ElevenLabs gives that number (starts with phnum_).
ELEVENLABS_PHONE_NUMBER_ID=
# The voice agent to use. Leave empty and the app creates one.
ELEVENLABS_AGENT_ID=

# Optional. Texts: sent through Twilio, from a number in this account, written like +14155550100.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# For a hosted copy: the whole site asks for this password before showing anything.
VEXO_PASSWORD=
