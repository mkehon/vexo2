# API keys are normally added in the app: open Settings in the top right corner.
# This file is the alternative. Copy it to .env.local, fill it in, and restart `npm run dev`.
# A key saved in Settings is used in preference to one set here.

# Required. Detection runs on TypeSafe's Jev model.
TYPESAFE_API_KEY=

# Optional. One of these lets an AI model turn each rule into a sharper yes/no question.
# Without one, rules use your sentence as written. Choose which to use in Settings.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
